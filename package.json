{
  "name": "custodia-evidence-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "python -m uvicorn backend.main:app --reload --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "start": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8787",
    "test": "python -m pytest -q",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup:python": "python -m pip install -r requirements.txt"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
